# --- Database ------------------------------------------------------------------
# Required. There is no fallback backend: without this the app refuses to start
# rather than serving a wall it invented.
#
# A plain Postgres, nothing more. The value below matches
# `scripts/docker-compose.yaml` — `pnpm db:local`, then
# `pnpm db:migrate && pnpm db:seed`.
DATABASE_URL=postgres://holdit:holdit@localhost:55432/holdit

# --- Stripe ------------------------------------------------------------------
# Without a secret key the buy flow records purchases locally (dev only, and
# refused when NODE_ENV=production).
#
# There is no catalogue product: the amount is whatever the buyer chose, so the
# checkout builds a one-off price per session. Point a webhook endpoint at
#   https://<your-domain>/api/webhooks/stripe
# subscribed to `checkout.session.completed`, and paste its signing secret here.
#
# Note: with Stripe you are the merchant of record — tax registration and
# remittance are yours, not the processor's.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Upstash (rate limiting; no-op when unset) -------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3001

# openssl rand -hex 32
CLICK_HASH_SALT=change-me-in-production

# --- Contact -----------------------------------------------------------------
# Shown on /rules and in the footer as the address for takedowns and refunds.
NEXT_PUBLIC_CONTACT_EMAIL=hello@holdit.lol
