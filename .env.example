# --- Database ------------------------------------------------------------------
# A plain Postgres, nothing more. The value below matches
# `scripts/docker-compose.yaml` — `pnpm db:local`, then
# `pnpm db:migrate && pnpm db:seed`.
DATABASE_URL=postgres://holdit:holdit@localhost:55432/holdit

# --- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Upstash (rate limiting; no-op when unset) -------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3001

# openssl rand -hex 32
CLICK_HASH_SALT=change-me-in-production

# --- Contact -----------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=holdit-lol@alexandremarques.io
