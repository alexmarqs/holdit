{
  "name": "holdit-lol",
  "version": "0.1.0",
  "private": true,
  "description": "A wall of everyone paying for attention, sized by live spend.",
  "license": "MIT",
  "author": "Alexandre Marques",
  "homepage": "https://holdit.lol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexmarqs/holdit.lol.git"
  },
  "bugs": {
    "url": "https://github.com/alexmarqs/holdit.lol/issues"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:local": "docker compose up -d --wait",
    "db:seed": "docker compose exec -T postgres psql -q -v ON_ERROR_STOP=1 -U holdit -d holdit -f /seed/seed.sql",
    "stripe:listen": "stripe listen --forward-to localhost:3001/api/webhooks/stripe"
  },
  "dependencies": {
    "@radix-ui/react-hover-card": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.102.2",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.2",
    "@vercel/analytics": "^2.0.1",
    "big.js": "^7.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "html-to-image": "^1.11.13",
    "jotai": "^2.20.3",
    "lucide-react": "1.33.0",
    "next": "16.3.1",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.5.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@tailwindcss/postcss": "4.3.3",
    "@types/big.js": "^7.0.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.4",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
